# =====================================================================
# GUARDIAN AI CONFIGURATION (.env)
# Provide ANY ONE of the following API keys to enable live AI analysis.
# If no key is set or --no-ai is passed, Guardian runs in deterministic mode.
# =====================================================================

# 1. Google Gemini API Key (Recommended for fast hackathon testing)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# 2. Anthropic Claude API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# 3. OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
