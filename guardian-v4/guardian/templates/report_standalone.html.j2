<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Software Supply Chain Guardian Report - {{ run.run_id }}</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --crit: #ef4444;
      --high: #f97316;
      --med: #eab308;
      --low: #3b82f6;
      --ok: #22c55e;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      margin: 0;
      padding: 24px;
    }
    .container { max-width: 1200px; margin: 0 auto; }
    h1, h2, h3 { margin-top: 0; color: #fff; }
    .badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 4px;
      font-weight: 600;
      font-size: 12px;
      text-transform: uppercase;
    }
    .badge-critical { background: #7f1d1d; color: #fca5a5; border: 1px solid var(--crit); }
    .badge-high { background: #7c2d12; color: #fdba74; border: 1px solid var(--high); }
    .badge-medium { background: #713f12; color: #fde047; border: 1px solid var(--med); }
    .badge-low { background: #1e3a8a; color: #93c5fd; border: 1px solid var(--low); }
    .badge-ok { background: #14532d; color: #86efac; border: 1px solid var(--ok); }
    .badge-status { font-size: 14px; padding: 6px 12px; }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 24px;
    }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 20px; }
    .metric {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid var(--border);
      padding: 14px;
      border-radius: 6px;
    }
    .metric-val { font-size: 24px; font-weight: bold; }
    .metric-lbl { font-size: 12px; color: var(--muted); text-transform: uppercase; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
    th, td { padding: 10px; text-align: left; border-bottom: 1px solid var(--border); }
    th { background: rgba(0, 0, 0, 0.2); color: var(--muted); font-size: 12px; }
    pre, code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
      background: #090d16;
      border-radius: 4px;
      padding: 2px 6px;
    }
    pre { padding: 12px; overflow-x: auto; }
    .evidence-box {
      background: #064e3b;
      border-left: 4px solid var(--ok);
      padding: 10px 14px;
      border-radius: 4px;
      margin: 8px 0;
      font-size: 13px;
    }
    .ai-box {
      background: #1e3a8a;
      border-left: 4px solid var(--low);
      padding: 10px 14px;
      border-radius: 4px;
      margin: 8px 0;
      font-size: 13px;
    }
  </style>
</head>
<body>
<div class="container">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <h1>Software Supply Chain Guardian</h1>
      <div style="color: var(--muted); font-size: 14px;">
        Run ID: <code>{{ run.run_id }}</code> &bull; Scanned: {{ summary.timestamp }} &bull; Source: <code>{{ run.source }}</code>
      </div>
      <div style="color: var(--muted); font-size: 13px; margin-top: 4px;">
        AI Status: <strong>{{ "ON (" + run.cheap_model + " / " + run.big_model + ")" if run.ai else "OFF (Deterministic rules only)" }}</strong> &bull;
        OSV: {{ snapshots.osv or "N/A" }} &bull; KEV: {{ snapshots.kev or "N/A" }}
      </div>
    </div>
    <div>
      <span class="badge badge-status {% if status == 'COMPLETE' %}badge-ok{% elif status == 'UNTRUSTED' %}badge-critical{% else %}badge-medium{% endif %}">
        Status: {{ status }}
      </span>
    </div>
  </div>

  <!-- KPI Grid -->
  <div class="grid">
    <div class="metric">
      <div class="metric-lbl">Total Components</div>
      <div class="metric-val">{{ summary.components_total }}</div>
      <div style="font-size: 11px; color: var(--muted);">Direct: {{ summary.components_direct }} | Transitive: {{ summary.components_transitive }}</div>
    </div>
    <div class="metric">
      <div class="metric-lbl">Vulnerabilities</div>
      <div class="metric-val" style="color: {% if summary.vulns_critical > 0 %}var(--crit){% elif summary.vulns_high > 0 %}var(--high){% else %}var(--text){% endif %};">
        {{ summary.vulns_total }}
      </div>
      <div style="font-size: 11px; color: var(--muted);">Crit: {{ summary.vulns_critical }} | High: {{ summary.vulns_high }} | Med: {{ summary.vulns_medium }} | Low: {{ summary.vulns_low }}</div>
    </div>
    <div class="metric">
      <div class="metric-lbl">New Risks Introduced</div>
      <div class="metric-val" style="color: {% if summary.new_risks > 0 %}var(--crit){% else %}var(--ok){% endif %};">
        {{ summary.new_risks }}
      </div>
      <div style="font-size: 11px; color: var(--muted);">Change findings: {{ summary.changes_count }}</div>
    </div>
    <div class="metric">
      <div class="metric-lbl">Execution & Cost</div>
      <div class="metric-val">{{ summary.total_duration }}s</div>
      <div style="font-size: 11px; color: var(--muted);">Tokens: {{ summary.total_tokens }} | Est USD: ${{ "%.4f"|format(summary.total_cost) }}</div>
    </div>
  </div>

  <!-- Coverage -->
  <div class="card">
    <h2>1. Ecosystem Coverage</h2>
    <table>
      <thead><tr><th>Status</th><th>Ecosystem</th><th>Details</th></tr></thead>
      <tbody>
        <tr><td><span class="badge badge-ok">Fully Analysed</span></td><td>npm (package-lock.json v2/v3)</td><td>{{ summary.components_total }} components mapped in dependency graph</td></tr>
        <tr><td><span class="badge badge-ok">Fully Analysed</span></td><td>Dockerfile & GitHub Actions</td><td>Static rules & permission checks complete</td></tr>
        <tr><td><span class="badge badge-medium">Roadmap (Skipped)</span></td><td>PyPI, Maven, Go</td><td>Out of scope for v4 hackathon spec; listed on roadmap</td></tr>
      </tbody>
    </table>
  </div>

  <!-- Findings -->
  <div class="card">
    <h2>2. Prioritised Findings (Evidence-Backed)</h2>
    {% if findings %}
      {% for f in findings %}
      <div style="border-bottom: 1px solid var(--border); padding: 14px 0;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div>
            <span class="badge badge-{{ f.risk }}">{{ f.risk }}</span>
            <strong style="margin-left: 8px; font-size: 16px;">{{ f.id }}: {{ f.title }}</strong>
            <span style="color: var(--muted); font-size: 13px; margin-left: 8px;">Score: {{ f.score }}/100</span>
          </div>
          <div>
            {% if f.flags.introduced %}<span class="badge badge-critical">Introduced by Change</span>{% endif %}
            {% if f.flags.reach == 'imported' %}<span class="badge badge-high">Imported</span>{% endif %}
            {% if f.flags.dev %}<span class="badge badge-low">Dev-only</span>{% endif %}
          </div>
        </div>

        <div style="margin: 8px 0; color: var(--muted); font-size: 13px;">
          Dependency Path: <code>{{ " &rarr; "|safe }}{{ f.path|join(" &rarr; ") }}</code>
        </div>

        <!-- Verified Evidence -->
        <div class="evidence-box">
          <strong>Verified Ledger Evidence [{{ f.evidence_ids|join(", ") }}]:</strong>
          <ul>
            {% for note in f.risk_notes %}
            <li>{{ note }}</li>
            {% endfor %}
            {% if f.detail %}<li>{{ f.detail }}</li>{% endif %}
          </ul>
        </div>

        <!-- AI Explanation -->
        {% if f.explanation %}
        <div class="ai-box">
          <strong>AI Analyst Explanation ({{ f.ai_status }}):</strong>
          <p style="margin: 4px 0 0 0;">{{ f.explanation }}</p>
          {% if f.skeptic %}
          <div style="margin-top: 6px; font-size: 12px; color: #bfdbfe;">
            Skeptic Second Opinion: <strong>{{ f.skeptic.opinion }}</strong> (Status: {{ f.skeptic.status }})
          </div>
          {% endif %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
    {% else %}
      <p style="color: var(--ok);">No security findings detected.</p>
    {% endif %}
  </div>

  <!-- What Changed -->
  <div class="card">
    <h2>3. What Changed (Supply Chain Diff)</h2>
    {% if changes and changes.items %}
    <table>
      <thead><tr><th>Package</th><th>Change Type</th><th>Old &rarr; New</th><th>Risk</th><th>Evidence</th></tr></thead>
      <tbody>
        {% for it in changes.items %}
        <tr>
          <td><code>{{ it.package }}</code></td>
          <td>{{ it.change_type }}</td>
          <td><code>{{ it.old or "-" }} &rarr; {{ it.new or "-" }}</code></td>
          <td><span class="badge badge-{{ 'critical' if it.change_type == 'unexpected_dependency' or it.change_type == 'new_install_script' else 'medium' }}">{{ it.change_type }}</span></td>
          <td><code>{{ it.evidence_id }}</code></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p style="color: var(--muted);">No baseline changes compared or repository is at baseline.</p>
    {% endif %}
  </div>

  <!-- Remediation & Validation -->
  <div class="card">
    <h2>4. Remediation & Verified Validation</h2>
    {% if validation %}
      <p>Validation Status: <strong><span class="badge {% if validation.status == 'validated' %}badge-ok{% else %}badge-medium{% endif %}">{{ validation.status }}</span></strong></p>
      <div style="font-size: 13px; color: var(--muted);">
        Finding: <code>{{ validation.finding_id }}</code> &bull; Option: <code>{{ validation.option_id }}</code> &bull; Approval Evidence: <code>{{ validation.approval_evidence }}</code>
      </div>
      {% if validation.patch %}
      <h3>Remediation Patch (Tested on sandbox copy)</h3>
      <pre><code>{{ validation.patch }}</code></pre>
      {% endif %}
    {% else %}
      <p style="color: var(--muted);">No remediation applied in this run.</p>
    {% endif %}
  </div>

  <!-- Run Health & Trace -->
  <div class="card">
    <h2>5. Observability & Agent Trace</h2>
    <table>
      <thead><tr><th>Agent</th><th>Status</th><th>Duration</th><th>Tokens</th><th>Cost</th><th>Cache Hits</th></tr></thead>
      <tbody>
        {% for span in trace %}
        <tr>
          <td><strong>{{ span.agent }}</strong></td>
          <td><span class="badge {% if span.status == 'ok' %}badge-ok{% elif span.status == 'waiting' %}badge-medium{% else %}badge-critical{% endif %}">{{ span.status }}</span></td>
          <td>{{ span.duration }}s</td>
          <td>{{ span.tokens }}</td>
          <td>${{ "%.5f"|format(span.cost or 0) }}</td>
          <td>{{ span.cache_hits }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
